# Node
node_modules/
*.log

# Nuxt / Nitro / Vite
.nuxt/
.output/
.nitro/
.cache/
dist/
.data/

# Firebase CLI
.firebase/
firebase-debug.log

# Rules pulled from the live project: they contain other apps' rules, which are
# not this repository's to carry.
.rules-backup/

# Firebase service account keys — these ARE secrets, unlike the web config.
*service-account*.json
*firebase-adminsdk*.json

# Env & secrets
.env
.env.*
!.env.example

# TLS material (không dùng nữa vì dev server chạy http; giữ để chặn lỡ tay commit key)
certs/
*.pem
*.key
*.crt
*.pfx

# Python (arms)
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ruff_cache/
.pytest_cache/

# Arm runtimes (binaries tải/build riêng từng arm)
arms/*/bin/
arms/*/build/

# Runtime storage: models, outputs, db, cache.
# Keep the directory skeleton, ignore everything actually stored in it.
storage/**/*
!storage/**/
!storage/**/.gitkeep

# OS / editor
Thumbs.db
.DS_Store
.idea/
*.swp
