# Firebase web config. Public by design: truy cập được kiểm soát bằng storage.rules,
# không phải bằng việc giấu các giá trị này.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Thư mục gốc trong bucket mà UI đọc/ghi. Bucket dùng chung cả project nên scope
# dưới ai-studio/ để không đụng dữ liệu của app khác.
NUXT_PUBLIC_STORAGE_PREFIX=ai-studio/uploads

# TURN relay (tuỳ chọn). Trống = chỉ dùng STUN.
NUXT_PUBLIC_TURN_URLS=
NUXT_PUBLIC_TURN_USERNAME=
NUXT_PUBLIC_TURN_CREDENTIAL=
