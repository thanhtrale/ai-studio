rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default deny. Anything not matched below is unreachable from the client.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Open the upload folder only to signed-in users, and cap object size so a
    // single client cannot run up the bill.
    match /uploads/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 200 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
  }
}
