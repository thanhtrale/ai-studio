# Copy to .env and fill in. .env is git-ignored; this file is not.

# --- Supervisor daemon ---
# Loopback only. The supervisor refuses to bind anything externally routable.
AISTUDIO_SUPERVISOR_HOST=127.0.0.1
AISTUDIO_SUPERVISOR_PORT=4319

# Shared credential presented by the web app on every supervisor control request.
# Any local process could otherwise drive arm start/stop. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AISTUDIO_SUPERVISOR_TOKEN=

# --- Paths ---
# Roots for arm discovery and for managed runtime data. Relative paths resolve
# from the repository root. Parameters that resolve outside AISTUDIO_STORAGE_DIR
# are rejected before any process is launched.
AISTUDIO_ARMS_DIR=./arms
AISTUDIO_STORAGE_DIR=./storage
